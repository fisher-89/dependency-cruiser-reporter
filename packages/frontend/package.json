{
  "name": "@dcr-reporter/frontend",
  "version": "0.1.0",
  "type": "module",
  "description": "dependency-cruiser result visualizer - dependency graph, error report & metrics viewer",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && biome check --write src/ && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "lint-deps": "dependency-cruiser --config .dependency-cruiser.json src/",
    "lint-deps-all": "dependency-cruiser --config .dependency-cruiser.json src/ -I",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@antv/g6": "5.1.1",
    "@likec4/core": "1.56.0",
    "@likec4/diagram": "1.56.0",
    "@likec4/layouts": "1.56.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@dcr-reporter/wasm": "workspace:*",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dependency-cruiser": "^17.3.0",
    "jsdom": "^29.1.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "dist/"
  ]
}
