{
  "name": "@dcr-reporter/cli",
  "version": "0.1.0",
  "description": "CLI and HTTP server for dependency-cruiser-reporter",
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && vp pack",
    "dev": "vp",
    "typecheck": "tsc --noEmit",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "knip": "knip",
    "check": "pnpm run lint:fix && pnpm run knip"
  },
  "dependencies": {
    "@dcr-reporter/wasm": "workspace:*",
    "@likec4/core": "1.56.0",
    "@likec4/language-services": "1.56.0",
    "commander": "^12.0.0",
    "dependency-cruiser": "^17.3.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.41",
    "knip": "^6.17.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
