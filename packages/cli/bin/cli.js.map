"specification {\n  element outer { // 系统外实体（例：用户、其他服务）\n    style {\n      color muted\n      size small\n    }\n  }\n  element project { // 工程\n    style {\n      shape browser\n    }\n  }\n  element package // 包\n  element module // 模块、组件\n\n  relationship dependency { // 依赖\n    line solid\n  }\n}\nmodel {\n  ROOT = project {\n    link ../../\n    // 此处拆分packages 或 module\n  }\n  USER = outer {\n    -> ROOT 'use'\n  }\n}\n\nviews {\n  view all of ROOT {\n    title 'all'\n    include *, ROOT.**\n  }\n  view top {\n    title 'top-only'\n    include ROOT.*\n  }\n}\n"