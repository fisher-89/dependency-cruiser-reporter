specification {
  element outer { // 系统外实体（例：用户、其他服务）
    style {
      color muted
      size small
    }
  }
  element project { // 工程
    style {
      shape browser
    }
  }
  element package // 包
  element module // 模块、组件

  relationship dependency { // 依赖
    line solid
  }
}
model {
  ROOT = project {
    link ../../
    // 此处拆分packages 或 module
  }
  USER = outer {
    -> ROOT 'use'
  }
}

views {
  view all of ROOT {
    title 'all'
    include *, ROOT.**
  }
  view top {
    title 'top-only'
    include ROOT.*
  }
}
