specification {
  element package
  element module
}

model {
  cli = package 'CLI' {
    commands = module 'Commands' {
      open = module 'Open'
      analyze = module 'Analyze'
    }
    server = module 'Server'
  }
  shared_lib = module 'SharedLib'
  db = module 'Database'
  server = module 'ServerModule'
}

views {
  view index {
    include *
  }
}
