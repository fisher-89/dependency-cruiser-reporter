specification {
  element package
  element module
  element component
  element path

  relationship dependency
}
model {
  cli = package 'Cli' '插件入口，提供analyze、open命令' {
    link ../../packages/cli
  }

  frontend = package 'Frontend'

  rust = package 'Rust' '自动聚合节点并计算布局' {
    link ../../packages/rust
  }

  cli -[dependency]-> frontend
}
views {
  view ROOT {
    title 'ROOT'
    include *, cli.**, frontend.**, rust.**
  }
}
