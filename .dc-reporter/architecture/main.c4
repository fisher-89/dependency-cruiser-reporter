specification {
  element outer {
    style {
      color muted
      size small
    }
  }
  element project {
    style {
      shape browser
    }
  }
  element package
  element module

  relationship dependency {
    line solid
  }
}
model {
  root = project 'project' {
    // 拆分packages 或 module
    cli = package 'cli' '插件入口，提供analyze、open命令' {
      link ../../packages/cli
    }

    frontend = package 'frontend'

    rust = package 'rust' '自动聚合节点并计算布局' {
      link ../../packages/rust
    }
  }

  user = outer 'User'

  user -> root 'use'
  user -> root.cli.bin 'use'
}
views {
  view all of root {
    title 'all'
    include *, root.**
  }

  view top {
    title 'top-only'
    include root.*
  }
}
