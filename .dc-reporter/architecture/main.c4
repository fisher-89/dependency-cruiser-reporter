specification {
  element outer {
    style {
      color muted
      size small
    }
  }
  element project {
    style {
      shape browser
    }
  }
  element package
  element module

  relationship dependency {
    line solid
  }
}
model {
  ROOT = project {
    // 拆分packages 或 module
    cli = package 'cli' '插件入口，提供analyze、open命令' {
      link ../../packages/cli
    }

    frontend = package 'frontend' {
      link ../../packages/frontend
    }

    rust = package 'rust' '高性能计算（自动聚合节点并计算布局）' {
      link ../../packages/rust
    }
  }

  USER = outer {
    -> ROOT.cli.bin 'use'
  }
}
views {
  view all of ROOT {
    title 'all'
    include *, ROOT.**
  }

  view top {
    title 'top-only'
    include ROOT.*
  }
}
