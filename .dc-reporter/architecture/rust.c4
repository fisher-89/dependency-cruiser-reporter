model {
  extend ROOT.rust {
    aggregate = module {
      description '聚合节点'

      -[dependency]-> ROOT.rust.types
    }

    layout = module {
      description '计算布局'

      -[dependency]-> ROOT.rust.types
    }

    violations = module {
      description '统计违规依赖'

      -[dependency]-> ROOT.rust.types
    }

    types = module {
      description '共享数据结构定义'
    }

    lib = module {
      description 'wasm入口'

      -[dependency]-> ROOT.rust.aggregate
      -[dependency]-> ROOT.rust.layout
      -[dependency]-> ROOT.rust.types
      -[dependency]-> ROOT.rust.violations
    }
  }
}
