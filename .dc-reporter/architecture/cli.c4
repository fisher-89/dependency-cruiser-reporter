model {
  extend ROOT.cli {
    bin = module {
      link ../../packages/cli/src/bin/cli.ts

      -[dependency]-> ROOT.cli.commands
    }

    commands = module {
      analyze = module
      open = module {
        -[dependency]-> ROOT.cli.server
      }
    }

    utils = module 'utils' {
      convert = module {
        -[dependency]-> ROOT.rust
      }
    }

    server = module {
      -[dependency]-> ROOT.cli.utils.convert
      -> ROOT.frontend 'express启动frontend/dist'
    }
  }
}