model {
  extend root.cli {
    bin = module 'bin' {
      link ../../packages/cli/src/bin/cli.ts

      root.cli.bin -[dependency]-> root.cli.commands.index
    }

    commands = module 'commands' {
      index = module 'index'

      analyze = module 'index' {
        link ../../packages/cli/src/commands/analyze.ts
      }
      open = module 'open'

      root.cli.commands.index -[dependency]-> root.cli.commands.analyze
      root.cli.commands.index -[dependency]-> root.cli.commands.open
      root.cli.commands.open -[dependency]-> root.cli.utils.server
    }

    utils = module 'utils' {
      server = module 'server'
      convert = module 'convert'

      root.cli.utils.server -[dependency]-> root.cli.utils.convert
      root.cli.utils.convert -[dependency]-> root.rust
      root.cli.utils.server -> root.frontend 'express启动frontend/dist'
    }

  }
}