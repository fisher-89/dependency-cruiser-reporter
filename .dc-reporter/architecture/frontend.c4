model {
  extend ROOT.frontend {
    main = module {
      -[dependency]-> ROOT.frontend.App
      -[dependency]-> ROOT.frontend.theme
      -[dependency]-> ROOT.frontend.i18n
    }

    theme = module

    i18n = module

    styles = module {
      -[dependency]-> ROOT.frontend.theme
    }

    App = module {
      -[dependency]-> ROOT.frontend.i18n
      -[dependency]-> ROOT.frontend.styles
      -[dependency]-> ROOT.frontend.components
      -[dependency]-> ROOT.frontend.types
    }

    components = module {
      -[dependency]-> ROOT.frontend.i18n
      -[dependency]-> ROOT.frontend.styles
      -[dependency]-> ROOT.frontend.hooks
      -[dependency]-> ROOT.frontend.types
    }

    hooks = module {
      -[dependency]-> ROOT.frontend.types
    }

    types = module
  }
}
